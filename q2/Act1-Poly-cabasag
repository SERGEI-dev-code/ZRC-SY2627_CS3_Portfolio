class Patient:
    def __init__(self, name: str, bill_amount: float):
        self.__name = name
        self.__bill_amount = bill_amount

    def get_name(self) -> str:
        return self.__name

    def set_name(self, name: str) -> None:
        self.__name = name

    def get_bill_amount(self) -> float:
        return self.__bill_amount

    def set_bill_amount(self, bill_amount: float) -> None:
        self.__bill_amount = max(0.0, bill_amount)

    def calculate_bill(self) -> float:
        return self.__bill_amount

    def display_patient_type(self) -> str:
        return "Regular Patient"


class SeniorPatient(Patient):
    def __init__(self, name: str, bill_amount: float):
        super().__init__(name, bill_amount)

    def calculate_bill(self) -> float:
        return super().calculate_bill() * 0.80

    def display_patient_type(self) -> str:
        return "Senior Citizen"


class PhilHealthPatient(Patient):
    def __init__(self, name: str, bill_amount: float):
        super().__init__(name, bill_amount)

    def calculate_bill(self) -> float:
        return super().calculate_bill() * 0.85

    def display_patient_type(self) -> str:
        return "PhilHealth Member"


if __name__ == "__main__":
    patient1 = Patient("Serge", 1000.00)
    senior1 = SeniorPatient("Calex", 1000.00)
    philhealth1 = PhilHealthPatient("Vinson", 1000.00)

    patients = [patient1, senior1, philhealth1]

    print("========================================")
    print("        HOSPITAL BILLING SYSTEM         ")
    print("========================================\n")

    for patient in patients:
        print(f"Patient Name  : {patient.get_name()}")
        print(f"Patient Type  : {patient.display_patient_type()}")
        print(f"Original Bill : ₱{patient.get_bill_amount():,.2f}")
        print(f"Final Bill    : ₱{patient.calculate_bill():,.2f}")
        print("-" * 40)